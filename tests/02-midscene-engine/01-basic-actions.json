{
  "version": "2.0",
  "flowMeta": {
    "name": "测试04: Midscene 基础操作",
    "desc": "验证 midscene.act 和 midscene.sleep 节点的基本功能"
  },
  "globalVars": {},
  "runtime": {
    "defaultTimeout": 180000,
    "defaultRetry": 1,
    "onError": "stop"
  },
  "modelConfig": {
    "midscene": {
      "inline": {
        "modelId": "doubao-seed-2-0-lite-260428",
        "apiKey": "YOUR_API_KEY_HERE",
        "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
        "modelFamily": "doubao-seed",
        "timeout": 180000,
        "retryCount": 1,
        "reasoningEnabled": false,
        "preferredLanguage": "zh"
      }
    }
  },
  "target": {
    "type": "computer"
  },
  "nodes": [
    {
      "id": "node-1",
      "nodeType": "midscene.act",
      "nodeName": "打开文本编辑",
      "nodeParams": {
        "prompt": "按 Cmd+Space 打开 Spotlight，输入 记事本 并按回车打开 TextEdit 应用"
      },
      "nextNodes": [{ "nodeId": "node-2" }]
    },
    {
      "id": "node-2",
      "nodeType": "midscene.sleep",
      "nodeName": "等待应用启动",
      "nodeParams": {
        "duration": 2000
      },
      "nextNodes": [{ "nodeId": "node-3" }]
    },
    {
      "id": "node-3",
      "nodeType": "midscene.act",
      "nodeName": "输入测试文字",
      "nodeParams": {
        "prompt": "在记事本中输入 'Hello Midscene!' 这段文字"
      },
      "nextNodes": [{ "nodeId": "node-4" }]
    },
    {
      "id": "node-4",
      "nodeType": "midscene.sleep",
      "nodeName": "等待输入完成",
      "nodeParams": {
        "duration": 1000
      },
      "nextNodes": [{ "nodeId": "node-5" }]
    },
    {
      "id": "node-5",
      "nodeType": "midscene.act",
      "nodeName": "全选并删除",
      "nodeParams": {
        "prompt": "按 Cmd+A 全选文字，然后按 Delete 删除"
      },
      "nextNodes": []
    }
  ]
}
